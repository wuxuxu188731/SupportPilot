# 依赖安装目录：一律不纳入版本控制
node_modules/

# 本机 npm 缓存（仅在受限环境用于绕开全局缓存目录写权限）
.npm-cache/

# 构建产物：一律不纳入版本控制
dist/

# 测试覆盖率报告
coverage/

# 本地环境变量与敏感配置：禁止提交（.env.example 除外）
.env
.env.local
.env.*.local

# 编辑器与操作系统临时文件
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# 日志
*.log
npm-debug.log*
