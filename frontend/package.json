{
  "name": "supportpilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SupportPilot 多租户电商售后客服 Agent 前端（认证与企业上下文阶段）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
