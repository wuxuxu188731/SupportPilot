# 复制本文件为 .env.local 后按需修改；本文件只存放占位示例，不含任何真实密钥。
# 开发环境请求统一以 /api 开头；真实密钥、内部地址一律不要写进本文件。

# Axios 的 API Base URL。开发环境默认使用 /api（由 Vite 开发服务器转发），
# 构建部署时改为真实后端网关地址，例如 https://support.example.com。
VITE_API_BASE_URL=/api

# Vite 开发服务器代理目标：/api 前缀会被移除后转发到这里。
# 后端默认地址 http://127.0.0.1:8000，可按实际部署修改。
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 聊天请求独立长超时（毫秒）：Agent 多轮工具调用可能耗时数十秒以上，
# 普通接口的 60 秒默认超时不够用；未设置时前端默认 180000（180 秒）。
# 注意：聊天请求超时后结果状态可能不确定，前端不自动重试。
VITE_CHAT_TIMEOUT_MS=180000
