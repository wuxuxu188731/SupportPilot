DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
CHAT_DB_PATH=chat_history.db
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=604800
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QDRANT_URL=http://localhost:6333
KNOWLEDGE_MIN_FUSED_SCORE=0.0
KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=30
KNOWLEDGE_RERANK_BASE_URL=https://ws-tocwkn1wc3xhur1f.cn-beijing.maas.aliyuncs.com/api/v1
# 通用问答检索策略；FAQ 语义匹配场景可改为 Retrieve semantically similar text.
KNOWLEDGE_RERANK_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.
# 允许跨域访问后端的来源（英文逗号分隔，支持 *）。不配置时默认放行本机前端
# 开发服务器 http://127.0.0.1:5173 与 http://localhost:5173；
# 前端若通过 Vite 的 /api 代理访问（默认方式）属于同源请求，无需配置本项。
# 分离部署时把前端站点来源写进来，例如 https://support.example.com
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# LlamaParse（llama-cloud）文档解析密钥：用于 docx/pdf 等富文本格式的提取，
# 该密钥仅在服务端使用，不应下发到前端。
LLAMA_CLOUD_API_KEY=replace-with-your-llama-cloud-key
